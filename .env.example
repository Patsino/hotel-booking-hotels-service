# ===========================================
# Hotel Booking Hotels Service - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values
# NEVER commit .env file to version control!
# ===========================================
# NOTE: For local development, use appsettings.json (LocalDB)
# For Docker, use .env.docker (SQL Server container)
# ===========================================

# -----------------------------
# ASP.NET Core Settings
# -----------------------------
ASPNETCORE_ENVIRONMENT=Development

# -----------------------------
# Database Configuration
# -----------------------------
# Uncomment to override appsettings.json connection string
# For local: Server=(localdb)\\mssqllocaldb;Database=HotelBooking;Trusted_Connection=True;TrustServerCertificate=True;
# For Docker: Server=sqlserver,1433;Database=HotelBooking;User Id=sa;Password=YourPassword;TrustServerCertificate=True;
# ConnectionStrings__HotelBookingDatabase=

# SQL Server SA Password (for Docker SQL Server container only)
# MSSQL_SA_PASSWORD=YourStrong@Passw0rd

# -----------------------------
# JWT Authentication
# -----------------------------
# IMPORTANT: Generate your own secure keys for production!
# Use: openssl rand -base64 64
Jwt__SecretKey=YOUR_JWT_SECRET_KEY_HERE_MIN_64_BYTES_BASE64
Jwt__Issuer=HotelBooking
Jwt__Audience=HotelBookingUsers
Jwt__ExpirationMinutes=60

# -----------------------------
# Encryption Settings
# -----------------------------
# IMPORTANT: Generate your own secure keys for production!
# Key: openssl rand -base64 32
# IV: openssl rand -base64 16
Encryption__Key=YOUR_ENCRYPTION_KEY_HERE_32_BYTES_BASE64
Encryption__IV=YOUR_ENCRYPTION_IV_HERE_16_BYTES_BASE64

# -----------------------------
# Service URLs (Inter-service Communication)
# -----------------------------
# Uncomment to override appsettings.json service URLs
# For local: http://localhost:808X
# For Docker: http://service-name:8080
# ServiceUrls__Reservations=http://localhost:8083
# ServiceUrls__Hotels=http://localhost:8082
# ServiceUrls__Payments=http://localhost:8084
# ServiceUrls__Users=http://localhost:8081

# -----------------------------
# API Keys (Service-to-Service Authentication)
# -----------------------------
# IMPORTANT: Generate your own secure keys for production!
# Use: openssl rand -base64 32
ApiKeys__Current=YOUR_HOTELS_SERVICE_API_KEY_HERE
ApiKeys__Services__UsersService=YOUR_USERS_SERVICE_API_KEY_HERE
ApiKeys__Services__HotelsService=YOUR_HOTELS_SERVICE_API_KEY_HERE
ApiKeys__Services__ReservationsService=YOUR_RESERVATIONS_SERVICE_API_KEY_HERE
ApiKeys__Services__PaymentsService=YOUR_PAYMENTS_SERVICE_API_KEY_HERE

# -----------------------------
# Logging
# -----------------------------
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
Logging__LogLevel__Microsoft.EntityFrameworkCore=Warning
